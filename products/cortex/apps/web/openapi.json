{
  "components": {
    "schemas": {
      "AppendTurnRequest": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          }
        },
        "required": ["content"],
        "title": "AppendTurnRequest",
        "type": "object"
      },
      "AppendTurnResponse": {
        "properties": {
          "conversation": {
            "$ref": "#/components/schemas/ConversationResponse"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TokenUsage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["conversation", "model"],
        "title": "AppendTurnResponse",
        "type": "object"
      },
      "BrainDiagnosticResponse": {
        "properties": {
          "dependency": {
            "const": "brain",
            "default": "brain",
            "title": "Dependency",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "disabled",
              "unauthorized",
              "malformed",
              "unavailable",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status"],
        "title": "BrainDiagnosticResponse",
        "type": "object"
      },
      "ChatMessage": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "enum": ["system", "user", "assistant"],
            "title": "Role",
            "type": "string"
          }
        },
        "required": ["role", "content"],
        "title": "ChatMessage",
        "type": "object"
      },
      "ChatTurnRequest": {
        "additionalProperties": false,
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          }
        },
        "required": ["messages"],
        "title": "ChatTurnRequest",
        "type": "object"
      },
      "ChatTurnResponse": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "$ref": "#/components/schemas/ChatMessage"
          },
          "model": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TokenUsage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["message", "model"],
        "title": "ChatTurnResponse",
        "type": "object"
      },
      "ConversationListResponse": {
        "properties": {
          "conversations": {
            "items": {
              "$ref": "#/components/schemas/ConversationSummary"
            },
            "title": "Conversations",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          }
        },
        "required": ["conversations", "limit", "offset"],
        "title": "ConversationListResponse",
        "type": "object"
      },
      "ConversationMessageResponse": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          }
        },
        "required": ["id", "sequence", "role", "content", "created_at"],
        "title": "ConversationMessageResponse",
        "type": "object"
      },
      "ConversationResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ConversationMessageResponse"
            },
            "title": "Messages",
            "type": "array"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "title", "created_at", "updated_at", "messages"],
        "title": "ConversationResponse",
        "type": "object"
      },
      "ConversationSummary": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "title", "created_at", "updated_at"],
        "title": "ConversationSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "const": "cortex-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["service", "status"],
        "title": "HealthResponse",
        "type": "object"
      },
      "LookupRequest": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": ["query"],
        "title": "LookupRequest",
        "type": "object"
      },
      "LookupResponse": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LookupResult"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["result"],
        "title": "LookupResponse",
        "type": "object"
      },
      "LookupResult": {
        "properties": {
          "content_markdown": {
            "title": "Content Markdown",
            "type": "string"
          },
          "page_id": {
            "format": "uuid",
            "title": "Page Id",
            "type": "string"
          },
          "page_version_id": {
            "format": "uuid",
            "title": "Page Version Id",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "snippet": {
            "title": "Snippet",
            "type": "string"
          },
          "source_titles": {
            "items": {
              "type": "string"
            },
            "title": "Source Titles",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "page_id",
          "page_version_id",
          "title",
          "path",
          "snippet",
          "content_markdown",
          "source_titles"
        ],
        "title": "LookupResult",
        "type": "object"
      },
      "TokenUsage": {
        "additionalProperties": false,
        "properties": {
          "input_tokens": {
            "minimum": 0.0,
            "title": "Input Tokens",
            "type": "integer"
          },
          "output_tokens": {
            "minimum": 0.0,
            "title": "Output Tokens",
            "type": "integer"
          }
        },
        "required": ["input_tokens", "output_tokens"],
        "title": "TokenUsage",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Cortex",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/chat/turn": {
      "post": {
        "operationId": "chat_turn_chat_turn_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatTurnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatTurnResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chat Turn",
        "tags": ["chat"]
      }
    },
    "/conversations": {
      "get": {
        "operationId": "list_conversations_conversations_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 10000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Conversations",
        "tags": ["conversations"]
      },
      "post": {
        "operationId": "create_conversation_conversations_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Conversation",
        "tags": ["conversations"]
      }
    },
